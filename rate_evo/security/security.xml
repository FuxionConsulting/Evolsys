<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Grupo funcional para usuarios de Rate Evo -->
    <record id="group_rate_evo_user" model="res.groups">
        <field name="name">Rate Evo Usuario</field>
    </record>

    <!-- Grupo funcional para administradores de Rate Evo -->
    <record id="group_rate_evo_manager" model="res.groups">
        <field name="name">Rate Evo Administrador</field>
        <field name="implied_ids" eval="[(4, ref('rate_evo.group_rate_evo_user'))]"/>
    </record>

</odoo>
