<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="currency_rate_provider_bcv_form" model="ir.ui.view">
        <field name="name">currency.rate.provider.bcv.form</field>
        <field name="model">currency.rate.provider</field>
        <field name="inherit_id" ref="currency_rate_live.currency_rate_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='service']" position="attributes">
                <attribute name="selection_add">[("BCV", "Banco Central de Venezuela")]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
