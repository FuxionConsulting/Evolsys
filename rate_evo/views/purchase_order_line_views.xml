<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_purchase_order_line_list_exchange_rate" model="ir.ui.view">
    <field name="name">purchase.order.line.list.exchange.rate</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">

      <xpath expr="//field[@name='order_line']//list/field[@name='price_unit']" position="after">
        <field name="price_unit_company_currency"
               string="PU convertido"
               widget="monetary"
               options="{'currency_field': 'converted_currency_id'}"
               readonly="1"
               optional="show"/>
      </xpath>

    </field>
  </record>
</odoo>
