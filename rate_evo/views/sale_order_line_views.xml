<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_line_tree_embedded_exchange_rate" model="ir.ui.view">
        <field name="name">sale.order.line.tree.embedded.exchange.rate</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>

        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="price_unit_company_currency" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
