<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- Botón actualizar conversión -->
  <record id="view_move_form_inherit_update_converted_prices" model="ir.ui.view">
    <field name="name">account.move.form.update.converted.prices</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_update_converted_prices"
                type="object"
                string="Actualizar conversión"
                class="btn-secondary"
                groups="account.group_account_invoice"
                invisible="not needs_conversion_update"/>
      </xpath>
    </field>
  </record>

</odoo>
