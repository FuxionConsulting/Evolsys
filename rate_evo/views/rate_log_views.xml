<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Vista list para logs -->
    <record id="view_rate_log_list" model="ir.ui.view">
        <field name="name">rate_evo.rate.log.list</field>
        <field name="model">rate_evo.rate.log</field>
        <field name="arch" type="xml">
            <list string="Logs de Tasas">
                <field name="timestamp"/>
                <field name="company_id"/>
                <field name="currency_provider"/>
                <field name="rate_id"/>
                <field name="action"/>
                <field name="status"/>
                <field name="user_id"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <!-- Vista form para logs -->
    <record id="view_rate_log_form" model="ir.ui.view">
        <field name="name">rate_evo.rate.log.form</field>
        <field name="model">rate_evo.rate.log</field>
        <field name="arch" type="xml">
            <form string="Logs de Tasas">
                <sheet>
                    <group>
                        <field name="timestamp"/>
                        <field name="company_id"/>
                        <field name="currency_provider"/>
                        <field name="rate_id"/>
                        <field name="action"/>
                        <field name="status"/>
                        <field name="user_id"/>
                        <field name="message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción y menú -->
    <record id="action_rate_log" model="ir.actions.act_window">
        <field name="name">Logs de Tasas</field>
        <field name="res_model">rate_evo.rate.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_rate_evo_logs" name="Logs de Tasas"
              parent="account.menu_finance_reports"
              action="action_rate_log"/>
</odoo>
