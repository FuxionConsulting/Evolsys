<odoo>
  <record id="view_order_form_with_converted_totals_safe" model="ir.ui.view">
    <field name="name">sale.order.form.with.converted.totals.safe</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="inside">
        <div class="o_converted_amounts" style="display:flex;justify-content:flex-end;margin-bottom:10px;border:none;">
          <div style="text-align:right;min-width:220px;">
            <h4 style="margin:0 0 6px 0;font-weight:600;">Totales convertidos</h4>
            <div style="margin-bottom:4px;">
              <field name="amount_untaxed_converted" widget="monetary"
                     options="{'currency_field': 'company_currency_id'}" readonly="1"/>
            </div>
            <div style="margin-bottom:4px;">
              <field name="amount_tax_converted" widget="monetary"
                     options="{'currency_field': 'company_currency_id'}" readonly="1"/>
            </div>
            <div>
              <field name="amount_total_converted" widget="monetary"
                     options="{'currency_field': 'company_currency_id'}" readonly="1"/>
            </div>
          </div>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
