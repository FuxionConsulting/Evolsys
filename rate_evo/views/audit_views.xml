<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Vista list para auditoría -->
    <record id="view_audit_exchange_rate_list" model="ir.ui.view">
        <field name="name">rate.evo.audit.exchange.rate.list</field>
        <field name="model">rate_evo.audit.exchange.rate</field>
        <field name="arch" type="xml">
            <list string="Auditoría de tasas de cambio">
                <field name="currency_id"/>
                <field name="old_rate"/>
                <field name="new_rate"/>
                <field name="user_id"/>
                <field name="timestamp"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <!-- Vista form para auditoría -->
    <record id="view_audit_exchange_rate_form" model="ir.ui.view">
        <field name="name">rate.evo.audit.exchange.rate.form</field>
        <field name="model">rate_evo.audit.exchange.rate</field>
        <field name="arch" type="xml">
            <form string="Auditoría de tasas de cambio">
                <sheet>
                    <group>
                        <field name="currency_id"/>
                        <field name="old_rate"/>
                        <field name="new_rate"/>
                        <field name="user_id"/>
                        <field name="timestamp"/>
                        <field name="reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción y menú -->
    <record id="action_audit_exchange_rate" model="ir.actions.act_window">
        <field name="name">Auditoría de Tasas</field>
        <field name="res_model">rate_evo.audit.exchange.rate</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_audit_exchange_rate" name="Auditoría de Tasas"
              parent="account.menu_finance_reports"
              action="action_audit_exchange_rate"/>
</odoo>
