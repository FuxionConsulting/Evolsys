<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_move_form_inherit_price_unit_company_currency" model="ir.ui.view">
    <field name="name">account.move.form.price.unit.company.currency</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>

    <field name="arch" type="xml">
      <xpath expr="//field[@name='invoice_line_ids']//list/field[@name='price_unit']" position="after">
        <field name="price_unit_company_currency"
               string="PU convertido"
               widget="monetary"
               options="{'currency_field': 'converted_currency_id'}"
               readonly="1"/>
      </xpath>
    </field>
  </record>
</odoo>
