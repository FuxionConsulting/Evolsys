<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Mostrar tasa de cambio debajo de la moneda -->
  <record id="view_purchase_order_form_currency_rate_below_partner" model="ir.ui.view">
    <field name="name">purchase.order.form.currency.rate.below.partner</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/group/group/field[@name='currency_id']" position="after">
        <field name="currency_rate"
               string="Tasa de cambio"
               widget="monetary"
               options="{'currency_field': 'company_currency_id'}"
               readonly="1"/>
      </xpath>
    </field>
  </record>

  <!-- Botón para actualizar PU convertido y totales convertidos -->
  <record id="view_purchase_order_form_update_converted_prices" model="ir.ui.view">
    <field name="name">purchase.order.form.update.converted.prices</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">

      <xpath expr="//header" position="inside">
        <button name="action_update_converted_prices"
                type="object"
                string="Actualizar conversión"
                class="btn-secondary"
                groups="purchase.group_purchase_user"
                invisible="not needs_conversion_update"
                help="Recalcula PU convertido y totales convertidos según la moneda actual del pedido"/>
      </xpath>

    </field>
  </record>

</odoo>
