<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_custom_report_tree" model="ir.ui.view">
    <field name="name">custom.invoice.report.tree</field>
    <field name="model">custom.invoice.report</field>
    <field name="arch" type="xml">
        <tree string="Reporte Personalizado de Facturas" create="false" edit="false" delete="true">
            <field name="invoice_id" string="Referencia" widget="many2one_avatar"/> 
            
            <field name="invoice_date"/>
            <field name="invoice_date_due"/>
            <field name="partner_id"/>
            
            <field name="amount_total" sum="Total Factura"/> 
            <field name="amount_credit_notes" sum="Total NC Conciliadas"/>
            <field name="amount_total_after_credit_notes" sum="Total Neto"/> 
            
            <button name="action_view_invoice" 
                    type="object" 
                    icon="fa-external-link" 
                    string="Ver" 
                    help="Abrir la factura relacionada"/>
            
            <field name="company_currency_id" invisible="1"/>
        </tree>
    </field>
</record>

    <record id="view_custom_report_search" model="ir.ui.view">
    <field name="name">custom.invoice.report.search</field>
    <field name="model">custom.invoice.report</field>
    <field name="arch" type="xml">
        <search string="Reporte de Facturas Personalizado">
            
            <field name="invoice_id" string="Referencia" filter_domain="[('invoice_id.name', 'ilike', self)]"/> 
            <field name="partner_id" string="Cliente"/>
            <field name="invoice_date" string="Fecha Factura"/>
            
            <field name="amount_total"/>
            <field name="amount_credit_notes"/>
            <field name="amount_total_after_credit_notes"/>
            
            <filter string="Con NC Conciliadas" 
                    name="has_credit_notes" 
                    domain="[('amount_credit_notes', '>', 0)]"/>
                    
            <filter string="Sin NC Conciliadas" 
                    name="no_credit_notes" 
                    domain="[('amount_credit_notes', '=', 0)]"/>
            
            <filter string="Por Fecha de Factura" name="group_by_date" context="{'group_by':'invoice_date'}"/>
        </search>
    </field>
</record>
    
    

    <record id="action_trigger_custom_report" model="ir.actions.server">
        <field name="name">Generar Reporte de Facturas Personalizado</field>
        <field name="model_id" ref="model_custom_invoice_report"/>
        <field name="state">code</field>
        <field name="code">action = model.action_generate_report()</field>
    </record>

    <menuitem 
        id="menu_custom_report_parent" 
        name="Reportes Personalizados" 
        parent="account.menu_finance_reports" 
        sequence="90"
        groups="base.group_user"/> 
        
    <menuitem 
        id="menu_custom_report_final" 
        name="Facturas c/ Notas de Crédito" 
        action="action_trigger_custom_report" 
        parent="menu_custom_report_parent" 
        sequence="10"
        groups="base.group_user"/>

</odoo>