<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="l10n_evo_view_partner_form_person" model="ir.ui.view">
      <field name="name">res.partner.form.l10n.ve.person</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form"/>
      <field name="arch" type="xml">

        <!-- Ocultar rif_type visualmente para personas (backend lo maneja) -->
        <xpath expr="//field[@name='vat']" position="before">
          <field name="rif_type">
            <attribute name="modifiers">{'invisible': True}</attribute>
          </field>
        </xpath>

        <!-- Modificar VAT para personas -->
        <xpath expr="//field[@name='vat']" position="attributes">
          <attribute name="placeholder">Cédula / RIF</attribute>
          <attribute name="modifiers">{'invisible': [('country_id', '!=', ref('base.ve'))]}</attribute>
        </xpath>

      </field>
    </record>
  </data>
</odoo>
