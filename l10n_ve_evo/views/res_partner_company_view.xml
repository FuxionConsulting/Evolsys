<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="l10n_ve_evo_view_partner_form_company" model="ir.ui.view">
            <field name="name">res.partner.form.l10n.ve.company</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">

                <!-- 1. Manejo del RIF -->
                <xpath expr="//field[@name='vat']" position="before">
                    <field name="rif_type" invisible="company_type == 'person'"/>
                </xpath>

                <xpath expr="//field[@name='vat']" position="attributes">
                    <attribute name="placeholder">RIF</attribute>
                    <attribute name="invisible">country_code != 'VE'</attribute>
                </xpath>

                <!-- 
                     2. SOLUCIÓN DEFINITIVA AL ERROR DE VALIDACIÓN:
                     En lugar de modificar el atributo 'domain', usamos un xpath para
                     REEMPLAZAR completamente cualquier campo city_id que Odoo intente validar
                     en la vista base. Al usar position="replace", el dominio conflictivo 
                     desaparece del árbol de XML antes de la validación final.
                -->
                <xpath expr="//field[@name='city_id']" position="replace">
                    <field name="city_id" 
                           placeholder="Ciudad" 
                           options="{'no_create': True}" 
                           domain="[('state_id', '=', state_id)]"
                           invisible="country_code != 'VE' or not state_id"
                           force_save="1"/>
                </xpath>

                <!-- 3. Insertar el resto de los campos de la localización -->
                <xpath expr="//field[@name='state_id']" position="after">
                    <field name="municipality_id" 
                           placeholder="Municipio" 
                           options="{'no_create': True}" 
                           domain="[('state_id', '=', state_id)]"
                           invisible="country_code != 'VE' or not state_id"/>

                    <field name="parish_id" 
                           placeholder="Parroquia" 
                           options="{'no_create': True}" 
                           domain="[('municipality_id', '=', municipality_id)]"
                           invisible="country_code != 'VE' or not municipality_id"/>
                </xpath>

                <!-- 
                    4. Limpieza de seguridad:
                    Si existe un div de dirección que contenga city_id, forzamos su reemplazo
                    para que no quede ninguna referencia al modelo res.city con el dominio country_id.
                -->
                <xpath expr="//div[contains(@class, 'o_address_format')]//field[@name='city_id']" position="replace">
                     <field name="city_id" 
                           placeholder="Ciudad" 
                           options="{'no_create': True}" 
                           domain="[('state_id', '=', state_id)]"
                           invisible="country_code != 'VE' or not state_id"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>