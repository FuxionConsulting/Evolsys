<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_l10n_ve_company" model="ir.ui.view">
        <field name="name">res.partner.form.l10n.ve.company</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>

        <field name="arch" type="xml">

            <!-- Insertar rif_type antes de vat (visible solo cuando no es persona) -->
            <xpath expr="//field[@name='vat']" position="before">
                <field name="rif_type">
                    <modifiers>
                        {"invisible": [["company_type", "=", "person"]]}
                    </modifiers>
                </field>
            </xpath>

            <!-- Modificar VAT (etiqueta RIF para VE) -->
            <xpath expr="//field[@name='vat']" position="attributes">
                <attribute name="placeholder">RIF</attribute>
                <attribute name="invisible">country_id != %(base.ve)d</attribute>
            </xpath>

            <!-- Campos geográficos -->
            <xpath expr="//field[@name='state_id']" position="after">

                <field name="city_id"
                       placeholder="Ciudad"
                       options="{'no_create': True}"
                       domain="[('state_id', '=', state_id)]">
                    <modifiers>
                        {"invisible": [["country_id", "!=", "%(base.ve)d"]]}
                    </modifiers>
                </field>

                <field name="municipality_id"
                       placeholder="Municipio"
                       options="{'no_create': True}"
                       domain="[('state_id', '=', state_id)]">
                    <modifiers>
                        {"invisible": [["country_id", "!=", "%(base.ve)d"]]}
                    </modifiers>
                </field>

                <field name="parish_id"
                       placeholder="Parroquia"
                       options="{'no_create': True}"
                       domain="[('municipality_id', '=', municipality_id)]">
                    <modifiers>
                        {"invisible": [["country_id", "!=", "%(base.ve)d"]]}
                    </modifiers>
                </field>

            </xpath>

        </field>
    </record>

</odoo>
