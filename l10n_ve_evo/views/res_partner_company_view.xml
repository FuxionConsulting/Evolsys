<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="l10n_ve_evo_view_partner_form_company" model="ir.ui.view">
            <field name="name">res.partner.form.l10n.ve.company</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">

                <!-- 1. Manejo del RIF: Esto rara vez da error -->
                <xpath expr="//field[@name='vat']" position="before">
                    <field name="rif_type" invisible="company_type == 'person'"/>
                </xpath>

                <xpath expr="//field[@name='vat']" position="attributes">
                    <attribute name="placeholder">RIF</attribute>
                    <attribute name="invisible">country_code != 'VE'</attribute>
                </xpath>

                <!-- 
                    2. ALTERNATIVA DE EMERGENCIA PARA EVITAR EL ERROR DE CITY_ID:
                    En lugar de modificar campos existentes que Odoo valida con dominios antiguos,
                    vamos a insertar nuestros campos geográficos en una nueva página (notebook)
                    o sección, evitando tocar el bloque de dirección estándar que está dando problemas.
                -->
                <xpath expr="//page[@name='internal_notes']" position="before">
                    <page string="Localización VE" name="l10n_ve_evo" invisible="country_code != 'VE'">
                        <group>
                            <group string="Ubicación Detallada">
                                <field name="city_id" placeholder="Ciudad" options="{'no_create': True}"/>
                                <field name="municipality_id" placeholder="Municipio" options="{'no_create': True}"/>
                                <field name="parish_id" placeholder="Parroquia" options="{'no_create': True}"/>
                            </group>
                        </group>
                    </page>
                </xpath>

            </field>
        </record>
    </data>
</odoo>