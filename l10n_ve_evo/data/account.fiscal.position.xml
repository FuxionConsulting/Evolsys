<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Posiciones fiscales para Venezuela (l10n__ve_evo) -->
    <record id="l10n_ve_evo_domestic_fp" model="account.fiscal.position">
      <field name="sequence">10</field>
      <field name="name">VE - Domestico (Ordinario)</field>
      <field name="auto_apply">True</field>
      <field name="country_id" ref="base.ve"/>
      <field name="vat_required">False</field>
    </record>

    <record id="l10n_ve_evo_contribuyente_fp" model="account.fiscal.position">
      <field name="sequence">20</field>
      <field name="name">VE - Contribuyente Especial</field>
      <field name="auto_apply">False</field>
      <field name="country_id" ref="base.ve"/>
      <field name="vat_required">True</field>
    </record>

    <record id="l10n_ve_evo_export_fp" model="account.fiscal.position">
      <field name="sequence">25</field>
      <field name="name">VE - Exportación (Exento)</field>
      <field name="auto_apply">False</field>
      <field name="country_id" ref="base.ve"/>
      <field name="vat_required">False</field>
    </record>
  </data>
</odoo>
