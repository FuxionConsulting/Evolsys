<odoo>
  <!-- Inherit invoice form: remove manual checkbox and show Retentions page -->
  <record id="view_move_form_inherit_retention" model="ir.ui.view">
    <field name="name">account.move.form.inherit.retention</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="inside">
        <!-- Removed manual checkbox generate_simple_retention to enforce automatic behavior -->
        <notebook position="inside">
          <page string="Retenciones">
            <field name="retention_simple_ids">
              <tree>
                <field name="retention_id" string="Referencia"/>
                <field name="invoice_amount" string="Base Imponible"/>
                <field name="iva_amount" string="IVA"/>
                <field name="retention_amount" string="Retención"/>
              </tree>
            </field>
          </page>
        </notebook>
      </xpath>
    </field>
  </record>
</odoo>
